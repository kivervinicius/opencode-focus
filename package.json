    "gnome-extension/",
    "bin/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "opencode-focus": "./bin/opencode-focus.mjs"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.85"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.11",
    "@opencode-ai/sdk": "^1.18.11",
    "@opentui/core": "^0.4.5",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck",
    "release": "npm publish"
  }
