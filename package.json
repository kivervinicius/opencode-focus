{
  "name": "opencode-focus",
  "version": "0.1.1",
  "description": "OpenCode plugin: status-aware terminal titles, minimal desktop notifications and click-to-focus window for the opencode TUI.",
  "type": "module",
  "license": "MIT",
  "author": "desenvolvedor",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "terminal",
    "title",
    "notification",
    "gnome",
    "wayland"
  ],
  "engines": {
    "opencode": ">=1.18.0",
    "node": ">=20"
  },
  "exports": {
    "./server": "./src/server.ts",
